# OpenAI — required
OPENAI_API_KEY=sk-...

# Airtable — required for CRM (get token at airtable.com/create/tokens)
AIRTABLE_TOKEN=pat...

# Twilio — optional, enables SMS to business owner on booking
TWILIO_SID=AC...
TWILIO_TOKEN=...
TWILIO_FROM=+1720...

# SendGrid — optional, enables email to business owner on booking
SENDGRID_API_KEY=SG...

# Admin endpoint protection — also seeds the dashboard 'admin' user's password
ADMIN_KEY=change-this-to-something-secret

# Set this after first Railway deploy — used by phase4.py to patch sites
RAILWAY_API_BASE=https://your-app-name.railway.app

# ── Sales dashboard ───────────────────────────────────────────────────────────
# Send cookies only over HTTPS (set true on the VPS, leave blank for local http).
DASHBOARD_SECURE_COOKIES=
# Allow running lead_finder.py / demos.py from the dashboard. Only where the full
# repo is checked out (local). Keep OFF on the VPS — the image lacks those scripts.
PIPELINE_ENABLED=true
# Repo root that holds candidates.csv + the pipeline scripts (default: parent of
# phase4_backend). Override if the layout differs.
# REPO_ROOT=/path/to/_lead_finder
# CANDIDATES_CSV_PATH=/path/to/candidates.csv
